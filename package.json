{
	"name": "@sistema54/deep-memory",
	"version": "1.0.0",
	"description": "Memory plugin for opencode using SQLite FTS5. Local, zero deps, automatic context recall.",
	"type": "module",
	"main": "src/deep-memory.ts",
	"exports": {
		".": {
			"import": "./src/deep-memory.ts",
			"default": "./src/deep-memory.ts"
		}
	},
	"opencode-plugin": true,
	"keywords": [
		"opencode",
		"plugin",
		"memory",
		"context",
		"fts5",
		"sqlite"
	],
	"license": "MIT",
	"author": "Alejandro Carraretto",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alejo54dev/deep-memory.git"
	},
	"bugs": {
		"url": "https://github.com/alejo54dev/deep-memory/issues"
	},
	"homepage": "https://github.com/alejo54dev/deep-memory#readme",
	"files": [
		"dist/",
		"src/",
		"tests/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "bun build ./src/deep-memory.ts --outdir ./dist --target bun",
		"test": "bun test",
		"prepublishOnly": "bun run build && bun test",
		"preversion": "bun test"
	}
}
